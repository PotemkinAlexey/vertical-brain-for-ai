{
  "version": 1,
  "namespace_path_shape": ["ROOT", "DOMAIN", "PROJECT", "OBJECT", "TOPIC"],
  "routing_contract": {
    "clarification_threshold": 0.65,
    "storage_operation_fields": [
      "operation",
      "target_path",
      "chunk",
      "links",
      "stale_candidates",
      "chunk_ids",
      "gold_aspect",
      "new_path",
      "confidence",
      "reasoning_summary"
    ],
    "route_decision_fields": [
      "target_path",
      "content_type",
      "layer",
      "action",
      "peer_links",
      "stale_candidates",
      "confidence",
      "reasoning_summary"
    ],
    "query_route_decision_fields": [
      "target_path",
      "allowed_context",
      "query_type",
      "confidence",
      "reasoning_summary"
    ]
  },
  "storage_operation_contract": {
    "payload_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "$ref": "#/$defs/storage_operation"
        },
        {
          "$ref": "#/$defs/storage_operation_batch"
        }
      ],
      "$defs": {
        "storage_operation_batch": {
          "type": "object",
          "required": ["operations"],
          "additionalProperties": false,
          "properties": {
            "operations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/storage_operation"
              }
            },
            "reasoning_summary": {
              "type": "string"
            },
            "branch_path": {
              "type": "string"
            },
            "start_version": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "storage_operation": {
          "type": "object",
          "required": ["operation", "target_path"],
          "additionalProperties": false,
          "properties": {
            "operation": {
              "type": "string",
              "enum": [
                "create_node",
                "append_chunk",
                "create_link",
                "mark_stale",
                "supersede_chunk",
                "append_gold_aspect",
                "rename_namespace"
              ]
            },
            "target_path": {
              "type": "string",
              "minLength": 1
            },
            "chunk": {
              "$ref": "#/$defs/chunk_input"
            },
            "links": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/link_input"
              }
            },
            "stale_candidates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/stale_candidate_input"
              }
            },
            "chunk_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "gold_aspect": {
              "type": "string"
            },
            "new_path": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "reasoning_summary": {
              "type": "string"
            }
          }
        },
        "chunk_input": {
          "type": "object",
          "required": ["content"],
          "additionalProperties": false,
          "properties": {
            "content": {
              "type": "string",
              "minLength": 1
            },
            "layer": {
              "type": "string",
              "enum": ["bronze", "silver", "gold"]
            },
            "content_type": {
              "type": "string",
              "enum": ["fact", "reference", "correction", "decision", "question", "note", "code", "artifact"]
            },
            "source": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "lineage": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "link_input": {
          "type": "object",
          "required": ["target_path", "link_type", "reason"],
          "additionalProperties": false,
          "properties": {
            "target_path": {
              "type": "string",
              "minLength": 1
            },
            "link_type": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "stale_candidate_input": {
          "type": "object",
          "required": ["path", "reason"],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "context_policy": {
    "default_search_limit": 10,
    "default_context_limit": 3,
    "default_items_per_context": 6,
    "default_max_context_items": 12,
    "default_link_expansion": "handles_only"
  },
  "storage_files": {
    "nodes": "nodes.json",
    "chunks": "chunks.json",
    "links": "links.json",
    "gold_summaries": "gold/**/*.md"
  }
}
