{
  "routing": {
    "clarification_threshold": 0.65,
    "default_route": {
      "target_path": "INBOX/Unclassified",
      "content_type": "note",
      "layer": "bronze",
      "action": "ask_clarification",
      "confidence": 0.4,
      "reasoning_summary": "No model rule matched."
    },
    "content_type_rules": [
      {
        "content_type": "correction",
        "match": {
          "any": ["correction", "instead", "not ", " use ", "should"]
        }
      },
      {
        "content_type": "decision",
        "match": {
          "any": ["decided", "decision"]
        }
      },
      {
        "content_type": "question",
        "match": {
          "any": ["?"]
        }
      }
    ],
    "query_type_rules": [
      {
        "query_type": "comparison",
        "match": {
          "any": ["compare", "difference", " vs "]
        }
      },
      {
        "query_type": "summary",
        "match": {
          "any": ["summarize", "summary"]
        }
      },
      {
        "query_type": "explanation",
        "match": {
          "starts_with": ["how ", "why ", "what "]
        }
      },
      {
        "query_type": "lookup",
        "match": {
          "ends_with": ["?"]
        }
      }
    ],
