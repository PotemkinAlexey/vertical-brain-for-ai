{
  "version": 1,
  "namespace_path_shape": ["ROOT", "DOMAIN", "PROJECT", "OBJECT", "TOPIC"],
  "routing_contract": {
    "clarification_threshold": 0.65,
    "route_decision_fields": [
      "target_path",
      "content_type",
      "layer",
      "action",
      "peer_links",
      "stale_candidates",
      "confidence",
      "reasoning_summary"
    ],
    "query_route_decision_fields": [
      "target_path",
      "allowed_context",
      "query_type",
      "confidence",
      "reasoning_summary"
    ]
  },
  "storage_files": {
    "nodes": "nodes.json",
    "chunks": "chunks.json",
    "links": "links.json",
    "gold_summaries": "gold/**/*.md"
  }
}
